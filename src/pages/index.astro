---
import Base from "../layouts/Base.astro";
import { pillars, projects } from "../data";
import { publicArticles } from "../lib";
import ArticleList from "../components/ArticleList.astro";
const articles = (await publicArticles()).slice(0, 3);
---

<Base title="主动设计自己的人生">
  <section class="hero wrap">
    <div class="hero-copy">
      <p class="eyebrow">
        <span class="status-dot"></span> HUMAN 3.0 / AN OPEN-ENDED EXPLORATION
      </p>
      <h1>
        人生的可能，
        <br />
        由自己<span class="accent-text">设计。</span>
      </h1>
      <p class="hero-english">
        Growth is not the destination.
        <br />
        <em>Freedom to create and explore is.</em>
      </p>
      <p class="hero-intro">
        我有数字营销专业背景，也在持续探索财富、健康与独立思考。这里记录我的思考与实践，慢慢构建一个更自由、更有自主权的人生。
      </p>
      <div class="hero-actions">
        <a class="button" href="/writing/">
          阅读文章 <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href="/about/">
          认识我 <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
    <div
      class="orbit-art"
      role="img"
      aria-label="由轨道与开放路径构成的探索示意图"
    >
      <span class="art-top">A LIFE, IN PROGRESS</span>
      <div class="orbit orbit-one"></div>
      <div class="orbit orbit-two"></div>
      <div class="orbit orbit-three"></div>
      <div class="orbit-axis"></div>
      <span class="orbit-center">自由</span>
      <span class="art-label label-a">THINK</span>
      <span class="art-label label-b">CREATE</span>
      <span class="art-label label-c">EXPLORE</span>
      <span class="orbit-point point-a"></span>
      <span class="orbit-point point-b"></span>
      <span class="art-bottom">
        没有标准答案，保持探索。<span>↗</span>
      </span>
    </div>
  </section>
  <section class="section pillars-section">
    <div class="wrap">
      <div class="section-heading">
        <div>
          <p class="eyebrow">THREE LENSES, ONE LIFE</p>
          <h2>从三个视角，重新看生活。</h2>
        </div>
        <p>
          让财富服务选择，让成长回到生活，
          <br />
          为独立思考留出空间。
        </p>
      </div>
      <div class="pillars">
        {pillars.map((p) => (
          <a class="pillar" href={`/writing/category/${p.id}/`}>
            <div class="pillar-top">
              <span>{p.number}</span>
              <span aria-hidden="true">↗</span>
            </div>
            <h3>{p.title}</h3>
            <p class="pillar-en">{p.english}</p>
            <p>{p.description}</p>
            <span class="small-link">探索这个主题 →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
  <section class="section wrap">
    <div class="section-heading">
      <div>
        <p class="eyebrow">NOTES & ESSAYS</p>
        <h2>最近的文字</h2>
      </div>
      <a class="text-link" href="/writing/">
        全部文章 ↗
      </a>
    </div>
    {articles.length ? (
      <ArticleList articles={articles} />
    ) : (
      <div class="empty-state">
        <span class="empty-mark" aria-hidden="true">
          ✳
        </span>
        <div>
          <h3>文字正在路上。</h3>
          <p>这里将收录经过整理、适合公开的思考。给想法一点生长的时间。</p>
        </div>
        <a class="text-link" href="/writing/">
          走进写作空间 →
        </a>
      </div>
    )}
  </section>
  <section class="section wrap projects-home">
    <div class="section-heading">
      <div>
        <p class="eyebrow">LEARNING BY DOING</p>
        <h2>在实践中寻找答案</h2>
      </div>
      <a class="text-link" href="/projects/">
        所有项目 ↗
      </a>
    </div>
    <div class="project-teasers">
      {projects.map((p) => (
        <a href={`/projects/#${p.id}`} class="project-teaser">
          <span class="project-index">
            {p.number} / {p.status}
          </span>
          <h3>{p.title}</h3>
          <p>{p.subtitle}</p>
          <span class="project-arrow" aria-hidden="true">
            ↗
          </span>
        </a>
      ))}
    </div>
  </section>
  <section class="closing wrap">
    <p class="eyebrow">A NOTE TO SELF</p>
    <p>
      成长不是终点。
      <br />
      有自由去创造与探索，才是。
    </p>
    <span>持续思考 · 小步实践 · 保持开放</span>
  </section>
</Base>
