---
import Base from "../layouts/Base.astro";
---

<Base title="页面未找到">
  <section class="wrap page-top spacious">
    <p class="eyebrow">404 / 暂时没有这页</p>
    <h1>换条路，继续探索。</h1>
    <p class="page-intro">这个地址可能已经变更，或者还没有内容。</p>
    <a class="button" href="/">
      回到首页 →
    </a>
  </section>
</Base>
