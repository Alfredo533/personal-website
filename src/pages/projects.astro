---
import Base from "../layouts/Base.astro";
import { projects } from "../data";
---

<Base title="Projects · 实践项目">
  <div class="wrap page-top">
    <p class="eyebrow">PROJECTS / 持续进行的实践</p>
    <h1>
      带着问题出发，
      <br />
      <span class="accent-text">在行动中学习。</span>
    </h1>
    <p class="page-intro">
      从想法到小范围实验。这里记录长期实践与正在探索的方向，项目介绍会随验证逐步更新。
    </p>
  </div>
  <div class="wrap project-list">
    {projects.map((p) => (
      <section class="project-detail" id={p.id}>
        <div class="project-number">{p.number}</div>
        <div>
          <span class="badge">{p.status}</span>
          <h2>{p.title}</h2>
          <p class="project-subtitle">{p.subtitle}</p>
          <p>{p.description}</p>
          <blockquote>{p.question}</blockquote>
          <ul class="tags" aria-label="项目标签">
            {p.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
          <p class="project-pending">
            后续更新：实验记录与阶段复盘，待整理公开。
          </p>
        </div>
      </section>
    ))}
  </div>
  <section class="wrap quiet-callout">
    <p>有些探索值得慢慢来。</p>
    <a class="text-link" href="/writing/">
      阅读相关思考 ↗
    </a>
  </section>
</Base>
