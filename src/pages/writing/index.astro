---
import Base from "../../layouts/Base.astro";
import { pillars } from "../../data";
import { publicArticles } from "../../lib";
import ArticleList from "../../components/ArticleList.astro";
const articles = await publicArticles();
---

<Base title="Writing · 文章">
  <div class="wrap page-top">
    <p class="eyebrow">WRITING / 思考的痕迹</p>
    <h1>
      把思考写下来，
      <br />
      <span class="accent-text">让理解慢慢生长。</span>
    </h1>
    <p class="page-intro">
      关于财富、健康与独立思考。记录问题，也给答案留一些余地。
    </p>
  </div>
  <section class="wrap writing-section" aria-label="文章列表">
    <nav class="filters" aria-label="文章分类">
      <a href="/writing/" aria-current="page">
        全部
      </a>
      {pillars.map((p) => (
        <a href={`/writing/category/${p.id}/`}>{p.title}</a>
      ))}
    </nav>
    {articles.length ? (
      <ArticleList articles={articles} />
    ) : (
      <div class="empty-state spacious">
        <span class="empty-mark" aria-hidden="true">
          ✳
        </span>
        <div>
          <h2>第一篇公开文章，待续。</h2>
          <p>这个空间会随着写作逐渐生长。目前还没有在本站公开的文章。</p>
        </div>
      </div>
    )}
    <aside class="sample-note">
      <div>
        <span class="badge">占位内容 · 非作者文章</span>
        <h3>想先看看文章的阅读体验？</h3>
        <p>这是一篇只展示排版的格式示例，不代表作者观点或真实经历。</p>
      </div>
      <a class="text-link" href="/writing/format-preview/">
        查看格式示例 ↗
      </a>
    </aside>
  </section>
</Base>
